<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Prog1_iti</title>
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Prog1_iti.styles.css" asp-append-version="true" />


    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f8f9fa;
        }

        .sidebar {
            min-height: 100vh;
            background: linear-gradient(180deg, #212529 0%, #343a40 100%);
            color: white;
            position: fixed;
            left: 0;
            top: 0;
            z-index: 1030;
            width: 250px;
            transition: margin-left 0.3s ease;
        }

        .sidebar .nav-link {
            color: rgba(255,255,255,0.8);
            margin-bottom: 4px;
            border-radius: 8px;
            padding: 10px 15px;
        }

        .sidebar .nav-link:hover, .sidebar .nav-link.active {
            background-color: #0d6efd;
            color: white;
        }

        .main-content {
            margin-left: 250px;
            padding: 20px;
            transition: margin-left 0.3s ease;
        }

        .navbar-custom {
            background-color: white;

            border-bottom: 1px solid #dee2e6;
            margin-left: 250px;
            position: sticky;
            top: 0;
            z-index: 1020;
            transition: margin-left 0.3s ease;
        }

        /* للموبايل */
        @@media (max-width: 768px) {
            .sidebar {
                margin-left: -250px; /* مخفية */
            }
            .sidebar.show {
                margin-left: 0; /* ظاهرة */
            }

            .main-content, .navbar-custom {
                margin-left: 0;
            }
        }


        .navbar-icon {
            font-size: 1.8rem; 
            color: #0d6efd;
        }
        /* Overlay لما السايدبار مفتوحه في الموبايل */
        .sidebar-overlay {
            display: none;
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.5);
            z-index: 1025;
        }
        .sidebar-overlay.show {
            display: block;
        }
    </style>
</head>
<body>

    <!-- Overlay -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <!-- Sidebar Navigation -->
    <div class="sidebar d-flex flex-column p-3" id="sidebar">
        <a asp-controller="Dashboard" asp-action="Index" class="d-flex align-items-center mb-4 text-white text-decoration-none">
            <i class="bi bi-box-seam me-2 fs-4"></i>
            <span class="fs-5 fw-bold">Inventory System</span>
        </a>
        <hr class="text-white-50">
        <ul class="nav nav-pills flex-column mb-auto">
            <li class="nav-item">
                <a asp-controller="Dashboard" 

asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard" ? "active" : "")">
                    <i class="bi bi-speedometer2 me-2"></i> Dashboard
                </a>
            </li>
            <li>
                <a asp-controller="Product" asp-action="Browse" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Product" ? "active" : "")">
                    <i class="bi bi-tags me-2"></i> Products
                </a>
            </li>
            <li>
                <a asp-controller="Categories" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Categories" ? "active" : "")">
                    <i class="bi bi-grid me-2"></i> Categories
                </a>
            </li>
            <li>
                <a asp-controller="Supplier" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Supplier" ? "active" : "")">
                    <i class="bi bi-truck me-2"></i> Suppliers
                </a>
            </li>
            <li>
                <a asp-controller="Sale" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Sale" ? "active" : "")">
                    <i class="bi bi-cart-check 

me-2"></i> Sales
                </a>
            </li>
            <li>
                <a asp-controller="Purchase" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Purchase" ? "active" : "")">
                    <i class="bi bi-receipt me-2"></i> Purchases
                </a>
            </li>
            <li>
                <a asp-controller="Chat" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Chat" ? "active" : "")">
                    <i class="bi bi-chat-dots me-2"></i> Chat Assistant
                </a>

            </li>
        </ul>
    </div>

    <!-- Top Navbar -->
    <nav class="navbar navbar-expand-lg navbar-custom shadow-sm p-3">
        <div class="container-fluid">
            <!-- زرار القائمة يظهر في الموبايل بس -->
            <button class="btn btn-outline-secondary d-lg-none me-2" type="button" id="sidebarToggle">
                <i class="bi bi-list"></i>
            </button>

            <span class="navbar-brand mb-0 h5 text-secondary">Welcome back, Admin</span>
        </div>
    </nav>

    <!-- Main Content Container -->
    <main class="main-content">
        <div class="container-fluid bg-white p-4 rounded-3 shadow-sm" style="min-height: 80vh;">
            @RenderBody()
        </div>
    </main>

    <footer class="border-top footer text-muted text-center">
        <div class="container">
            Project Devloped by Team_6_ITI       
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-

version="true"></script>
    
    <script>
        // كود فتح وقفل السايدبار في الموبايل
        const sidebar = document.getElementById('sidebar');
        const sidebarToggle = document.getElementById('sidebarToggle');
        const sidebarOverlay = document.getElementById('sidebarOverlay');

        sidebarToggle.addEventListener('click', function () {
            sidebar.classList.toggle('show');
            sidebarOverlay.classList.toggle('show');
        });

        

sidebarOverlay.addEventListener('click', function () {
            sidebar.classList.remove('show');
            sidebarOverlay.classList.remove('show');
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
