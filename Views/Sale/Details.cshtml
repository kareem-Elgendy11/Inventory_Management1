@model InventoryApp_v2.Models.Sale

<h2>Sale Details</h2>

<div class="card p-4">

    <p>
        <strong>Sale ID:</strong>
        @Model.Id
    </p>

    <p>
        <strong>Date:</strong>
        @Model.SaleDate
    </p>

    <p>
        <strong>Customer:</strong>
        @Model.CustomerInfo
    </p>

    <p>
        <strong>Total:</strong>
        @Model.Totalamount
    </p>

    <hr />

    <h4>Products</h4>

    @foreach (var item in Model.SaleItems)
    {
        <p>
            @item.Product?.Name
            ×
            @item.Quantity
            =
            @(item.Quantity* item.Price)
        </p>
    }

</div>

<a asp-action="Index" class="btn btn-secondary">
    Back
</a>