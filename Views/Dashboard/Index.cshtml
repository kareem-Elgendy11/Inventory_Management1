@model InventoryApp_v2.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<h2 class="mb-4">Dashboard</h2>

<div class="row g-3">
    <div class="col-md-3">
        <div class="card text-white bg-primary">
            <div class="card-body">
                <h6>Total Products</h6>
                <h3>@Model.TotalProducts</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-secondary">
            <div class="card-body">
                <h6>Total Categories</h6>
                <h3>@Model.TotalCategories</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-success">
            <div class="card-body">
                <h6>Total Suppliers</h6>
                <h3>@Model.TotalSuppliers</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-danger">
            <div class="card-body">
                <h6>Low Stock Alerts</h6>
                <h3>@Model.LowStockProductsCount</h3>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mt-1">
    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <h6>Total Stock Quantity</h6>
                <h4>@Model.TotalStockQuantity</h4>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <h6>Purchases</h6>
                <h4>@Model.TotalPurchasesCount</h4>
                <small>Value: @Model.TotalPurchasesValue.ToString("N2")</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <h6>Sales</h6>
                <h4>@Model.TotalSalesCount</h4>
                <small>Revenue: @Model.TotalSalesRevenue.ToString("N2")</small>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-6">
        <h5>Most Sold Products</h5>
        <canvas id="topProductsChart"></canvas>
    </div>
    <div class="col-md-6">
        <h5>Recent Activity</h5>
        <table class="table table-striped">
            <thead>
                <tr><th>Type</th><th>Description</th><th>Date</th><th>Amount</th></tr>
            </thead>
            <tbody>
                @foreach (var item in Model.RecentActivity)
                {
                    <tr>
                        <td>@item.Type</td>
                        <td>@item.Description</td>
                        <td>@item.Date.ToString("yyyy-MM-dd")</td>
                        <td>@item.Amount.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ctx = document.getElementById('topProductsChart');
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: [@Html.Raw(string.Join(",", Model.MostSoldProducts.Select(p => $"'{p.ProductName}'")))],
                datasets: [{
                    label: 'Quantity Sold',
                    data: [@string.Join(",", Model.MostSoldProducts.Select(p => p.TotalQuantitySold))],
                    backgroundColor: '#0d6efd'
                }]
            }
        });
    </script>
}
