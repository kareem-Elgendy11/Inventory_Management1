@model productviewmodel
@{
    ViewData["title"] = "add";
}
<h1>add product</h1>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Add Product</title>
</head>
<body class="bg-light">
    <div class="container mt-5" style="max-width: 600px;">
        <div class="card shadow">
            <div class="card-header bg-success

text-white">
                <h5>Add New Product</h5>
            </div>
            <div class="card-body">
                <form method="post" asp-action="add"asp-controller="product">
                    <div class="mb-3">
                        <label class="form-label"asp-for="Name"></label>
                        <input asp-for="Name" class="form-control" required>
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="mb-3"><label class="form-label">Category</label>
                        <select class="form-select"asp-for="CategoryId">
                            @foreach(var category in Model.Categories)
                            {
                            <option value="@category.Id">@category.Name </option>
                            }
                        </select>
                     </div>
                    <div class="mb-3">
                        <label class="form-label"asp-for="Price"></label>
                        <input  class="form-control"asp-for="Price" required>
                        <span asp-validation-for="Price" class="text-danger"></span>

                    </div>
                    <div class="mb-3">
                        <label class="form-label"asp-for="Quantity"></label>
                        <input type="number" class="form-control"asp-for="Quantity" required>
                        <span asp-validation-for="Quantity" class="text-danger"></span>

                    </div>
                    <div class="mb-3">
                        <label class="form-label" asp-for="sku">SKU </label>
                        <input  class="form-control"asp-for="sku" >
                        <span asp-validation-for="sku" class="text-danger"></span>

                    </div>
                    <div class="mb-3">
                        <label class="form-label"asp-for="LowStokThreshold"></label>
                        <input type="number" class="form-control"asp-for="LowStokThreshold" required>
                        <span asp-validation-for="LowStokThreshold" class="text-danger"></span>

                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Browse"asp-controller="product" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn bg-success text-white">Save Product</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
